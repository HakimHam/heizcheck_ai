{
  "name": "heizcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node --env-file-if-exists=.env.local --import tsx eval/run.ts",
    "make-fixture": "tsx eval/make-fixture.ts",
    "rag:pdf": "tsx scripts/rag/export-pdfs.ts",
    "rag:seed": "node --env-file-if-exists=.env.local --import tsx scripts/rag/seed.ts",
    "rag:ask": "node --env-file-if-exists=.env.local --import tsx scripts/rag/ask.ts",
    "rag:eval": "node --env-file-if-exists=.env.local --import tsx scripts/rag/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@pinecone-database/pinecone": "^9.0.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "openai": "^7.33.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "md-to-pdf": "^5.2.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  }
}
