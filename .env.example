# Supabase project in Frankfurt (eu-central-1). Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The retention job only (/api/retention): it deletes what is 4 years old as the
# service role. Settings → API Keys → secret key. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. Any long random string.
CRON_SECRET=

# How PDFs are read: fake (default), anthropic (development only), bedrock (ticket 17). See README.
EXTRACTOR=fake
# Only with EXTRACTOR=anthropic or EXPLAIN_CHAT_ENABLED=true. Never set it in Vercel production.
ANTHROPIC_API_KEY=

# The help chat (ticket 19, ADR 0004): dev/demo only, never set these in Vercel production.
# The icon shows only while the URL is set. The URL is the n8n Webhook node's production URL.
N8N_HELP_WEBHOOK_URL=
# Sent as `X-HeizCheck-Secret`; the Webhook node's Header Auth credential checks it. Any long random string.
N8N_HELP_WEBHOOK_SECRET=

# The explain chat (ticket 20, ADR 0005): dev/demo only. "true" shows an "Erklären" button on each
# rule with a Finding; it calls Claude Haiku with ANTHROPIC_API_KEY. Ignored when VERCEL_ENV=production,
# unless EXPLAIN_CHAT_IN_PRODUCTION=true: a deliberate demo opt-in, only with test data (ADR 0005).
EXPLAIN_CHAT_ENABLED=
EXPLAIN_CHAT_IN_PRODUCTION=

# The own RAG over docs/rag-source/ (npm run rag:seed / rag:ask / rag:eval). Answers
# come from Claude via ANTHROPIC_API_KEY above; embeddings need OpenAI.
OPENAI_API_KEY=
PINECONE_API_KEY=
# Defaults: own index heizcheck-rag (created on the first seed), namespace
# heizcheck-own-rag. Never workshop-shared.
RAG_PINECONE_INDEX=heizcheck-rag
RAG_PINECONE_NAMESPACE=heizcheck-own-rag
